{
  "expo": {
    "name": "Vently",
    "slug": "Vently",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ventlyIcon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.Vently"
    },
    "web": {
      "favicon": "./assets/ventlyIcon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "scheme": "vently"
  }
}
